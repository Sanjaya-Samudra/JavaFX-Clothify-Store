<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #f8fafc;" stylesheets="@../modern-theme.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.item.ItemManagementController">
   <children>
      <HBox spacing="16.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0">
         <children>
            <!-- Left Side: Product Form Editor (38%) -->
            <VBox prefWidth="380.0" spacing="12.0" styleClass="card">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="card-title" text="Product Information" />
                        <Label styleClass="heading-subtitle" text="Add or modify apparel specifications" />
                     </children>
                  </VBox>

                  <HBox spacing="8.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Product Code" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtItemCode" prefHeight="34.0" promptText="P011" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" prefWidth="150.0">
                           <children>
                              <Label text="Category" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="cmbCategory" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Select" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="4.0">
                     <children>
                        <Label text="Product Name" textFill="#334155">
                           <font>
                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtName" prefHeight="34.0" promptText="e.g. Slim-Fit Cotton Oxford Shirt" />
                     </children>
                  </VBox>

                  <HBox spacing="8.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Size" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="cmbSize" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Select Size" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Unit Price (LKR)" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtPrice" prefHeight="34.0" promptText="4500.00" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="8.0">
                     <children>
                        <VBox spacing="4.0" prefWidth="120.0">
                           <children>
                              <Label text="Stock Quantity" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtQuantity" prefHeight="34.0" promptText="50" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Supplier" textFill="#334155">
                                 <font>
                                    <Font name="System Bold" size="11.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="cmbSupplier" maxWidth="1.7976931348623157E308" prefHeight="34.0" promptText="Supplier Name" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <!-- Image Preview Box (Light theme) -->
                  <VBox alignment="CENTER" prefHeight="165.0" spacing="8.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                     <children>
                        <ImageView fx:id="itemImageView" fitHeight="115.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
                        <HBox alignment="CENTER" spacing="8.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#btnBrowseImageOnAction" styleClass="btn-secondary" text="Choose Image" />
                              <Button mnemonicParsing="false" onAction="#btnClearImageOnAction" styleClass="btn-outline" text="Remove" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Action Buttons -->
                  <HBox spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="38.0" styleClass="btn-success" text="+ Add Item" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="38.0" styleClass="btn-primary" text="Update Item" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <HBox spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="34.0" styleClass="btn-danger" text="Delete Item" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="34.0" styleClass="btn-secondary" text="Clear Form" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Right Side: Search, Filter, and Table (62%) -->
            <VBox spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <TextField fx:id="txtSearch" onKeyReleased="#onSearchKeyReleased" prefHeight="38.0" promptText="Search catalog by code, name, supplier..." HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbTableCategoryFilter" onAction="#onTableCategoryFilterChanged" prefHeight="38.0" prefWidth="140.0" promptText="Category" />
                        <Button mnemonicParsing="false" onAction="#btnRefreshTableOnAction" prefHeight="38.0" styleClass="btn-secondary" text="Refresh" />
                     </children>
                  </HBox>

                  <TableView fx:id="tblItems" prefHeight="540.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                      <TableColumn fx:id="colCode" maxWidth="90.0" minWidth="70.0" prefWidth="80.0" text="Code" />
                      <TableColumn fx:id="colName" minWidth="180.0" prefWidth="240.0" text="Product Name" />
                      <TableColumn fx:id="colCategory" maxWidth="140.0" minWidth="85.0" prefWidth="95.0" text="Category" />
                      <TableColumn fx:id="colSize" maxWidth="75.0" minWidth="50.0" prefWidth="60.0" text="Size" />
                      <TableColumn fx:id="colPrice" maxWidth="140.0" minWidth="85.0" prefWidth="95.0" text="Price (LKR)" />
                      <TableColumn fx:id="colStock" maxWidth="90.0" minWidth="65.0" prefWidth="75.0" text="Stock" />
                      <TableColumn fx:id="colSupplier" maxWidth="300.0" minWidth="130.0" prefWidth="160.0" text="Supplier" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
