<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1100.0" style="-fx-background-color: #f8fafc;" stylesheets="@../modern-theme.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.order.PosOrderController">
   <children>
      <HBox spacing="16.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="16.0">
         <children>
            <!-- Left: Product Catalog & Search (60%) -->
            <VBox spacing="14.0" styleClass="card" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <StackPane>
                           <children>
                              <ImageView fitHeight="38.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../Images/logo-background-removed-nav.png" />
                                 </image>
                              </ImageView>
                           </children>
                        </StackPane>
                        <VBox HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="heading-title" text="Point of Sale (POS)" />
                              <Label styleClass="heading-subtitle" text="Select products to add to cart or search by code/name" />
                           </children>
                        </VBox>
                        <ComboBox fx:id="cmbCategoryFilter" onAction="#onCategoryFilterChanged" prefHeight="38.0" prefWidth="160.0" promptText="All Categories" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#btnViewOrderHistoryOnAction" prefHeight="38.0" style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8; -fx-border-color: #bfdbfe; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 12;" text="Placed Orders" />
                     </children>
                  </HBox>

                  <!-- Search Bar -->
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="txtSearchProduct" onAction="#onSearchEnter" prefHeight="38.0" promptText="Type product code, name or barcode..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#btnAddSelectedItemToCart" prefHeight="38.0" styleClass="btn-primary" text="+ Add Product" />
                     </children>
                  </HBox>

                  <!-- Product Table -->
                  <TableView fx:id="tblCatalog" onMouseClicked="#onCatalogRowClicked" prefHeight="420.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                      <TableColumn fx:id="colCatCode" maxWidth="90.0" minWidth="70.0" prefWidth="80.0" text="Code" />
                      <TableColumn fx:id="colCatName" minWidth="160.0" prefWidth="220.0" text="Item Name" />
                      <TableColumn fx:id="colCatCategory" maxWidth="150.0" minWidth="95.0" prefWidth="110.0" text="Category" />
                      <TableColumn fx:id="colCatSize" maxWidth="80.0" minWidth="65.0" prefWidth="70.0" text="Size" />
                      <TableColumn fx:id="colCatPrice" maxWidth="140.0" minWidth="90.0" prefWidth="100.0" text="Price (LKR)" />
                      <TableColumn fx:id="colCatStock" maxWidth="90.0" minWidth="65.0" prefWidth="75.0" text="Stock" />
                    </columns>
                  </TableView>

                  <!-- Active Selection & Quick Info Pill -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-padding: 6 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                     <children>
                        <Label fx:id="lblSelectedItemSummary" text="👗 Click any product above to select" textFill="#475569">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Qty to Add:" textFill="#334155">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtAddQty" prefHeight="34.0" prefWidth="70.0" text="1" />
                        <Button mnemonicParsing="false" onAction="#btnQuickAddOne" prefHeight="34.0" styleClass="btn-secondary" text="+1" />
                        <Button mnemonicParsing="false" onAction="#btnQuickAddTwo" prefHeight="34.0" styleClass="btn-secondary" text="+2" />
                        <Button mnemonicParsing="false" onAction="#btnQuickAddFive" prefHeight="34.0" styleClass="btn-secondary" text="+5" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAddToCart" mnemonicParsing="false" onAction="#btnAddSelectedItemToCart" prefHeight="34.0" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 16;" text="🛒 Add Item to Cart ➔" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Right: Interactive Shopping Cart & Payment Terminal (40%) -->
            <VBox prefWidth="440.0" spacing="12.0" styleClass="card">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
               <children>
                  <!-- Cart Header -->
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <VBox HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="card-title" text="Customer Cart" />
                              <Label fx:id="lblOrderId" text="Order #ORD-1004" textFill="#d97706">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#btnClearCartOnAction" styleClass="btn-secondary" text="Clear Cart" />
                     </children>
                  </HBox>

                  <!-- Customer Details -->
                  <HBox spacing="8.0">
                     <children>
                        <TextField fx:id="txtCustomerName" prefHeight="32.0" promptText="Customer Name (Optional)" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtCustomerPhone" prefHeight="32.0" prefWidth="130.0" promptText="Phone / Email" />
                     </children>
                  </HBox>

                  <!-- Cart Table -->
                  <TableView fx:id="tblCart" prefHeight="230.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                      <TableColumn fx:id="colCartName" minWidth="130.0" prefWidth="170.0" text="Item" />
                      <TableColumn fx:id="colCartPrice" maxWidth="110.0" minWidth="75.0" prefWidth="85.0" text="Price" />
                      <TableColumn fx:id="colCartQty" maxWidth="75.0" minWidth="50.0" prefWidth="60.0" text="Qty" />
                      <TableColumn fx:id="colCartTotal" maxWidth="120.0" minWidth="80.0" prefWidth="90.0" text="Total" />
                    </columns>
                  </TableView>

                  <HBox alignment="CENTER_RIGHT">
                     <children>
                        <Button mnemonicParsing="false" onAction="#btnRemoveCartItemOnAction" styleClass="btn-danger" text="Remove Item" />
                     </children>
                  </HBox>

                  <!-- Calculations Panel (Light Boutique Styling) -->
                  <VBox spacing="6.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Subtotal:" textFill="#64748b" />
                              <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblSubTotal" text="LKR 0.00" textFill="#0f172a">
                                       <font>
                                          <Font name="System Bold" size="13.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                           <children>
                              <Label text="Discount (%):" textFill="#64748b" />
                              <TextField fx:id="txtDiscountPercent" onKeyReleased="#onDiscountChanged" prefHeight="26.0" prefWidth="60.0" text="0" />
                              <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblDiscountAmount" text="- LKR 0.00" textFill="#d97706" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="NET TOTAL:" textFill="#0f172a">
                                 <font>
                                    <Font name="System Bold" size="15.0" />
                                 </font>
                              </Label>
                              <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="lblNetTotal" text="LKR 0.00" textFill="#059669">
                                       <font>
                                          <Font name="System Bold" size="20.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Payment Mode & Cash Tender -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="Payment:" textFill="#64748b">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="cmbPaymentType" prefHeight="32.0" prefWidth="110.0" />
                        <TextField fx:id="txtAmountTendered" onKeyReleased="#onTenderedChanged" prefHeight="32.0" promptText="Amount Tendered" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Balance / Change:" textFill="#64748b">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblChangeAmount" text="LKR 0.00" textFill="#2563eb">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </HBox>

                  <!-- Complete Order Button -->
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#btnCompleteOrderOnAction" prefHeight="45.0" styleClass="btn-success" text="Complete Sale &amp; Print Receipt ➔">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</AnchorPane>
